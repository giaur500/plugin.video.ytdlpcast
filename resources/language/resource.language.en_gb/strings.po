msgctxt "#30011"
msgid "yt-dlp could not resolve this video"
msgstr ""

msgctxt "#30012"
msgid "No playable stream found"
msgstr ""

msgctxt "#30013"
msgid "Open settings"
msgstr ""

msgctxt "#30100"
msgid "Playback"
msgstr ""

msgctxt "#30101"
msgid "Fall back to a progressive stream"
msgstr ""

msgctxt "#30102"
msgid "If no HLS manifest is offered, play the best single file that carries both video and audio. Most YouTube videos no longer have one, so this rarely helps."
msgstr ""

msgctxt "#30103"
msgid "Send the legacy manifest_type property"
msgstr ""

msgctxt "#30104"
msgid "InputStream Adaptive 21 detects HLS from the mime type. Enable this only if playback fails with a manifest type error on an older build."
msgstr ""

msgctxt "#30110"
msgid "Picture & sound"
msgstr ""

msgctxt "#30111"
msgid "Maximum resolution"
msgstr ""

msgctxt "#30112"
msgid "Variants above this height are removed from the manifest before InputStream Adaptive sees it. \"No limit\" leaves the choice to its adaptive logic."
msgstr ""

msgctxt "#30113"
msgid "No limit"
msgstr ""

msgctxt "#30114"
msgid "2160p (4K)"
msgstr ""

msgctxt "#30115"
msgid "1440p"
msgstr ""

msgctxt "#30116"
msgid "1080p"
msgstr ""

msgctxt "#30117"
msgid "720p"
msgstr ""

msgctxt "#30118"
msgid "480p"
msgstr ""

msgctxt "#30119"
msgid "Video codec"
msgstr ""

msgctxt "#30120"
msgid "YouTube offers H.264 and VP9 up to 1080p and VP9 alone above it. \"H.264 only\" caps playback at 1080p; \"VP9 only\" needs hardware VP9 decoding. A choice that would leave nothing to play is ignored."
msgstr ""

msgctxt "#30121"
msgid "Auto"
msgstr ""

msgctxt "#30122"
msgid "H.264 only"
msgstr ""

msgctxt "#30123"
msgid "VP9 only"
msgstr ""

msgctxt "#30124"
msgid "Audio track"
msgstr ""

msgctxt "#30125"
msgid "InputStream Adaptive on Kodi 21 starts YouTube's packed-ADTS audio silent until the first seek. \"fMP4 (fixed)\" replaces it with YouTube's DASH AAC track in fMP4, read by the same demuxer as the video, so sound plays from the first frame. \"As published\" keeps YouTube's own audio (silent-until-seek) for diagnosis."
msgstr ""

msgctxt "#30126"
msgid "fMP4 (fixed)"
msgstr ""

msgctxt "#30127"
msgid "As published"
msgstr ""

msgctxt "#30140"
msgid "Subtitles"
msgstr ""

msgctxt "#30141"
msgid "Download subtitles"
msgstr ""

msgctxt "#30142"
msgid "Downloads every subtitle track the video's author uploaded, as files Kodi labels by language. Kodi then picks the one matching its own \"Preferred subtitle language\" setting. YouTube's automatic captions are not used: they are machine output, and the translated ones require browser TLS impersonation that no Kodi add-on can provide."
msgstr ""






msgctxt "#30150"
msgid "Rewrite the manifest (enables the settings below)"
msgstr ""

msgctxt "#30151"
msgid "The settings below work by rewriting YouTube's HLS master playlist and serving the copy from 127.0.0.1 to InputStream Adaptive. Switch this off to hand over YouTube's manifest untouched, exactly as version 1.0 did — no rewriting, no local server."
msgstr ""

msgctxt "#30152"
msgid "Quality selection"
msgstr ""

msgctxt "#30153"
msgid "\"Adaptive\" keeps every allowed variant and lets InputStream Adaptive switch by measured bandwidth. \"Best available\" keeps only the tallest, highest-bitrate variant that passed the codec and resolution settings, so it plays at that quality from the first second — and buffers rather than adapts if the connection cannot carry it."
msgstr ""

msgctxt "#30154"
msgid "Adaptive"
msgstr ""

msgctxt "#30155"
msgid "Best available"
msgstr ""

msgctxt "#30156"
msgid "Local manifest server port"
msgstr ""

msgctxt "#30157"
msgid "Rewritten manifests are served to InputStream Adaptive from 127.0.0.1 on this port. Change it only if another add-on already uses it (plugin.video.youtube uses 50152); the server restarts on its own."
msgstr ""

msgctxt "#30160"
msgid "yt-dlp"
msgstr ""

msgctxt "#30161"
msgid "Update channel"
msgstr ""

msgctxt "#30162"
msgid "Where new yt-dlp versions come from. Nightly is built every day from the project's main branch, and fixes for YouTube changes arrive there first. Stable is released less often (yt-dlp promises a release at least every 90 days). After switching, use \"Check for updates now\"."
msgstr ""

msgctxt "#30163"
msgid "Nightly"
msgstr ""

msgctxt "#30164"
msgid "Stable"
msgstr ""

msgctxt "#30165"
msgid "Update automatically"
msgstr ""

msgctxt "#30166"
msgid "Checks for a new yt-dlp a minute after Kodi starts and then once a day, in the background. A new version is used only after it has been checked against Kodi's Python: one that needs a newer Python is rejected and the current one stays."
msgstr ""

msgctxt "#30167"
msgid "Check for updates now"
msgstr ""

msgctxt "#30168"
msgid "Checks the selected channel right away and shows the result."
msgstr ""

msgctxt "#30170"
msgid "yt-dlp {} is up to date"
msgstr ""

msgctxt "#30171"
msgid "yt-dlp updated to {}"
msgstr ""

msgctxt "#30172"
msgid "yt-dlp update not applied: {}"
msgstr ""

msgctxt "#30173"
msgid "yt-dlp update failed: {}"
msgstr ""

msgctxt "#30174"
msgid "Checking for yt-dlp updates…"
msgstr ""

msgctxt "#30180"
msgid "Cast"
msgstr ""

msgctxt "#30181"
msgid "Receive casts from the YouTube app"
msgstr ""

msgctxt "#30182"
msgid "Kodi appears as a TV in the YouTube app on your phone: tap the cast button and pick it. Videos then play here through yt-dlp, and the phone works as the remote. While this is on, Kodi keeps one connection to youtube.com open so the phone can reach it."
msgstr ""

msgctxt "#30183"
msgid "Name shown on the phone"
msgstr ""

msgctxt "#30184"
msgid "Leave empty for Kodi's own name followed by \"(yt-dlp)\", e.g. \"CoreELEC (yt-dlp)\" — different from what TubeCast shows, should both be installed."
msgstr ""

msgctxt "#30185"
msgid "Discoverable on the local network"
msgstr ""

msgctxt "#30186"
msgid "Answers the YouTube app's search on the local network (SSDP and DIAL), so Kodi shows up in the cast menu by itself. Switch off to connect only with a TV code."
msgstr ""

msgctxt "#30187"
msgid "Link with a TV code"
msgstr ""

msgctxt "#30188"
msgid "Shows a code to type into the YouTube app (Settings → Watch on TV → Enter TV code). Works when the phone is on another network, or when the local search does not find Kodi. A linked phone stays linked across restarts."
msgstr ""

msgctxt "#30189"
msgid "Detailed cast log"
msgstr ""

msgctxt "#30190"
msgid "Writes every step of casting to kodi.log, without Kodi's debug mode: discovery, pairing, each command from the phone and each answer to it. Search the log for \"cast/\". Warnings and errors are logged either way."
msgstr ""

